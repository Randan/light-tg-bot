# Required - Telegram Bot API token
BOT_TOKEN=

# Server port for health endpoint (default 3000)
PORT=3000

# development | production
NODE_ENV=production

# silent | error | warn | info (default info)
LOG_LEVEL=info

# Optional - Telegram chat ID for admin error notifications
ADMIN_TELEGRAM_ID=

# MongoDB
DB_URL=
DB_SUBSCRIPTIONS_COLLECTION=light_subscriptions
DB_HISTORY_COLLECTION=light_history
DB_SCHEDULE_COLLECTION=outage_schedules

# Tuya
TUYA_ACCESS_KEY=
TUYA_SECRET_KEY=
TUYA_BASE_URL=https://openapi.tuyaus.com
TUYA_DEVICE_ID=
# Minutes between Tuya polls (1..59, default 3). Trial Edition quota is ~26k API calls/month:
# 3 min = ~15k calls in a 31-day month; 1 min burns the quota in ~2.5 weeks.
TUYA_POLL_INTERVAL_MINUTES=3

# YASNO (DTEK Kyiv) planned outage schedule. Optional: disabled unless the address
# or a fixed group is set. The address is kept by name: the bot finds YASNO's
# internal ids itself and finds them again when YASNO renumbers its addresses.
# Kyiv = region 25, DTEK Kyiv = dso 902.
YASNO_REGION_ID=25
YASNO_DSO_ID=902
# Street name as on yasno.ua, with or without "вул.", e.g. Тираспольська
YASNO_STREET=
# House number exactly as on yasno.ua, e.g. 54 or 10Б
YASNO_HOUSE=
# Overrides the address lookup, e.g. 19.1
YASNO_GROUP=
# Minutes between schedule polls (1..59, default 10); YASNO caches responses for 5 min
YASNO_POLL_INTERVAL_MINUTES=10

# Time zone of the schedule and of the /stats periods (e.g. Europe/Kyiv)
TIMEZONE=Europe/Kyiv
