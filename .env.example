# Required - Telegram Bot API token
BOT_TOKEN=

# Server port for health endpoint (default 3000)
PORT=3000

# development | production
NODE_ENV=production

# silent | error | warn | info (default info)
LOG_LEVEL=info

# Optional - Telegram chat ID for admin error notifications
ADMIN_TELEGRAM_ID=

# MongoDB
DB_URL=
DB_SUBSCRIPTIONS_COLLECTION=light_subscriptions
DB_HISTORY_COLLECTION=light_history

# Tuya
TUYA_ACCESS_KEY=
TUYA_SECRET_KEY=
TUYA_BASE_URL=https://openapi.tuyaus.com
TUYA_DEVICE_ID=
# Minutes between Tuya polls (1..59, default 3). Trial Edition quota is ~26k API calls/month:
# 3 min = ~15k calls in a 31-day month; 1 min burns the quota in ~2.5 weeks.
TUYA_POLL_INTERVAL_MINUTES=3

# Cron timezone (e.g. Europe/Kyiv)
TIMEZONE=Europe/Kyiv
